# Copy to .env in the project root before running `docker compose up --build`.
# This file configures the compose stack only. It is NOT the backend's .env.

# Required - compose refuses to start without it.
POSTGRES_PASSWORD=change_me_before_running

POSTGRES_USER=polaris
POSTGRES_DB=polaris

# Baked into the frontend bundle at build time.
VITE_API_URL=http://localhost:8000/api
