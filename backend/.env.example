# ============================================================================
# POLARIS - backend configuration
#
# Copy to .env for local development. In production set these as the
# platform's environment variables (Render / Railway dashboard) - never
# commit a real .env. `.env` is gitignored.
# ============================================================================

# --- Environment ---------------------------------------------------------
# "development" or "production".
#   production => CORS is restricted to CORS_ORIGINS exactly (no localhost
#                 wildcard) and tracebacks are not returned to clients.
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
# Set false to hide /docs and /redoc on a public deployment.
ENABLE_DOCS=true

# --- PostgreSQL ----------------------------------------------------------
# LOCAL: use the discrete parts.
POSTGRES_USER=polaris
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polaris

# PRODUCTION: managed providers hand you a single URL - set DATABASE_URL and
# the parts above are ignored. Render / Neon / Supabase all give you this.
# Both postgres:// and postgresql:// are accepted and normalised to the
# psycopg 3 driver automatically.
#
#   Render    postgresql://user:pass@dpg-xxxx.oregon-postgres.render.com/polaris
#   Neon      postgresql://user:pass@ep-xxxx.aws.neon.tech/polaris?sslmode=require
#   Supabase  postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres
#
# DATABASE_URL=

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- CORS ----------------------------------------------------------------
# Comma-separated browser origins allowed to call this API.
# In production this MUST list your deployed frontend origin exactly.
#   CORS_ORIGINS=https://polaris-sih.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Live weather ingestion ----------------------------------------------
# NO API KEY IS REQUIRED. All three providers POLARIS uses are keyless:
#   * OGIMET      - WMO SYNOP relay for Maitri (WMO 89514)
#   * Open-Meteo  - free, no registration
#   * NOAA AWC    - public US government endpoint
# There is deliberately no WEATHER_API_KEY variable, because nothing needs one.
#
# ALLOW_NETWORK_INGEST=false makes POLARIS perform no outbound calls at all.
# It then serves the last genuine observation flagged stale - it does not
# substitute generated data.
ALLOW_NETWORK_INGEST=true
WEATHER_TIMEOUT_S=25
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# --- Model ---------------------------------------------------------------
# Days of real weather history loaded for training and state estimation.
HISTORY_DAYS=120
# Hours ahead the AI forecast and optimiser plan for. 168 h = 7 days.
FORECAST_HORIZON_H=168
RANDOM_SEED=20260921

# --- Not required by this application ------------------------------------
# SECRET_KEY: POLARIS has no authentication, sessions or cookies - it is a
# read-mostly decision-support API - so there is nothing to sign or encrypt.
# If you later add auth, add SECRET_KEY here and load it from the platform's
# secret store, never from the repository.
